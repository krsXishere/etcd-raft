# ─────────────────────────────────────────────────────────────────
# .env – Default environment variables for docker compose
# ─────────────────────────────────────────────────────────────────

# Network profile: low-latency | high-latency | none
NETWORK_PROFILE=low-latency

# Remote node location: surabaya (for low-latency) or papua (for high-latency)
REMOTE_LOCATION=surabaya

# Workload pattern: steady | bursty
WORKLOAD_PATTERN=steady

# Benchmark settings
BENCHMARK_DURATION=60s
BENCHMARK_RATE=100
BENCHMARK_BURST_RATE=500
BENCHMARK_WARMUP=15s
