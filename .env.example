# ─────────────────────────────────────────────────────────────────
# .env.example – Default environment variables for docker compose
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and customize the values for your setup

# ── Traffic Control: Hub nodes (node1, node2, node3 – "Jakarta") ──
TC_DELAY_HUB=2ms
TC_JITTER_HUB=1ms
TC_LOSS_HUB=0.1%
TC_CORRELATION_HUB=25%

# ── Traffic Control: Remote nodes (node4, node5) ─────────────────
# Jakarta-Surabaya (Low Latency) preset:
TC_DELAY_REMOTE=10ms
TC_JITTER_REMOTE=3ms
TC_LOSS_REMOTE=0.1%
TC_CORRELATION_REMOTE=25%
#
# Jakarta-Papua (High Latency / Unstable) preset – uncomment to switch:
# TC_DELAY_REMOTE=150ms
# TC_JITTER_REMOTE=50ms
# TC_LOSS_REMOTE=2%
# TC_CORRELATION_REMOTE=25%

# ── Adaptive Mode ─────────────────────────────────────────────────
# Set to "true" for PID-controlled adaptive election timeout,
# or "false" for static (fixed) Raft timeouts.
ADAPTIVE_MODE=true

# ── PID Controller Tuning (only used when ADAPTIVE_MODE=true) ────
BASELINE_RTT=50ms
T_BASE=1s
T_MIN=500ms
T_MAX=5s
KP=1.5
KI=0.2
KD=0.1

# ── Workload ──────────────────────────────────────────────────────
# Pattern: steady | bursty
WORKLOAD_PATTERN=steady

# Benchmark settings
BENCHMARK_DURATION=60s
BENCHMARK_RATE=100
BENCHMARK_BURST_RATE=500
BENCHMARK_WARMUP=15s
